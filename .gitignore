# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
# Packaging output. `python -m build` writes a copy of the source tree here,
# so without this the linter and formatter also process build artifacts and
# a second, stale copy of the source ends up committed.
build/
dist/
/artifacts/
.deepeval/

# Virtual environments
venv/
.venv/
env/

# Secrets & local config
.env
.env.local
# File-based secrets, bind-mounted to /run/secrets by docker-compose.yml.
# Credentials written here must never reach the index; only the directory
# placeholder is tracked.
deploy/secrets/*
!deploy/secrets/.gitkeep
# A stray top-level secrets/ is easy to create by accident, nothing references
# it, and `git add -A` would happily commit whatever landed in it.
secrets/

# IDE
.idea/
.vscode/

# Runtime artefacts
*.log
# Anchored to the repository root. Unanchored, this also matched
# evals/data/, which kept the golden dataset out of every clone and failed
# the eval tests anywhere but the machine that wrote it.
/data/
description.txt
backups/
