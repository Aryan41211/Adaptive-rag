# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# Secrets & local config
.env
.env.local
# File-based secrets, bind-mounted to /run/secrets by docker-compose.yml.
# Credentials written here must never reach the index; only the directory
# placeholder is tracked.
deploy/secrets/*
!deploy/secrets/.gitkeep

# IDE
.idea/
.vscode/

# Runtime artefacts
*.log
# Anchored to the repository root. Unanchored, this also matched
# evals/data/, which kept the golden dataset out of every clone and failed
# the eval tests anywhere but the machine that wrote it.
/data/
description.txt
backups/
