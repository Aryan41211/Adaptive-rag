# ---------------------------------------------------------------------------
# Adaptive RAG - Production environment configuration
# Copy to .env on the production VM and fill in.
# This file documents production-safe defaults.
# ---------------------------------------------------------------------------

# --- Model providers ---------------------------------------------------------
# "gemini" (free tier, requires GEMINI_API_KEY), "openai" (paid, requires
# OPENAI_API_KEY) or "ollama" (local/free, not practical on Render's free
# tier). The default below runs on the free tiers of Gemini + Qdrant Cloud +
# MongoDB Atlas with no per-token bill.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- Required ---------------------------------------------------------------
# A Google AI Studio key (free tier, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=            # Required while a Gemini provider is selected
# Verified model names for a fresh Google account; the legacy
# gemini-2.5-flash / text-embedding-004 names return 404 for new accounts.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JWT_SECRET_KEY=            # Required: min 32 chars, generate with:
                           #   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required by docker compose ----------------------------------------------
MONGO_ROOT_USERNAME=adaptive
MONGO_ROOT_PASSWORD=      # Required: generate with:
                          #   python -c "import secrets; print(secrets.token_hex(24))"

# --- Optional: vector store -------------------------------------------------
# Qdrant Cloud free tier: set the cluster URL and an API key under Access
# Management > API Keys. Local compose alternative: http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=           # Required for Qdrant Cloud
QDRANT_COLLECTION=adaptive_rag_documents

# --- Optional: persistence --------------------------------------------------
# MongoDB Atlas free tier, or the bundled compose Mongo.
#   Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#   Compose: mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/?authSource=admin
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# --- Optional: web search ---------------------------------------------------
TAVILY_API_KEY=

# --- Optional: models & behaviour -------------------------------------------
# OpenAI model names, used while the matching provider is "openai".
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Ollama settings, used while the matching provider is "ollama". In compose
# the bundled service is reachable at http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MAX_HISTORY_MESSAGES=20
MAX_UPLOAD_BYTES=10485760
MAX_REWRITE_ATTEMPTS=2
MAX_VERIFY_ATTEMPTS=1

# --- Optional: rate limiting ------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Production: security ---------------------------------------------------
# Disable API docs in production — the schema enumerates the attack surface.
ENABLE_API_DOCS=false
# Only answer to your production hostname.
ALLOWED_HOSTS=rag.example.com
# Allow your frontend origin to call the API.
CORS_ALLOW_ORIGINS=https://rag.example.com

# --- Production: logging ----------------------------------------------------
LOG_LEVEL=WARNING

# --- Production: Grafana ----------------------------------------------------
GRAFANA_ADMIN_PASSWORD=   # Required: set a strong password

# --- Optional: tracing ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adaptive-rag

# --- Optional: frontend -----------------------------------------------------
API_BASE_URL=http://api:8000

# --- Optional: secrets from files -------------------------------------------
SECRETS_DIR=/run/secrets
