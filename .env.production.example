# ---------------------------------------------------------------------------
# Adaptive RAG - Production environment configuration
# Copy to .env on the production VM and fill in.
# This file documents production-safe defaults.
# ---------------------------------------------------------------------------

# --- Model providers ---------------------------------------------------------
# "gemini" (free tier, requires GEMINI_API_KEY), "openai" (paid, requires
# OPENAI_API_KEY) or "ollama" (local/free, not practical on Render's free
# tier). The default below runs on the free tiers of Gemini + Qdrant Cloud +
# MongoDB Atlas with no per-token bill.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- Required ---------------------------------------------------------------
# A Google AI Studio key (free tier, no credit card): https://aistudio.google.com/apikey
# Required while a Gemini provider is selected.
GEMINI_API_KEY=
# Model names verified to serve for fresh Google accounts (new accounts get 404
# for the legacy gemini-2.5-flash / text-embedding-004 names).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JWT_SECRET_KEY=            # Required: min 32 chars, generate with:
                           #   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required by docker compose ----------------------------------------------
MONGO_ROOT_USERNAME=adaptive
MONGO_ROOT_PASSWORD=      # Required: generate with:
                          #   python -c "import secrets; print(secrets.token_hex(24))"

# --- Optional: vector store -------------------------------------------------
# Qdrant Cloud free tier: set the cluster URL and an API key under Access
# Management > API Keys. Local compose alternative: http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=           # Required for Qdrant Cloud
QDRANT_COLLECTION=adaptive_rag_documents

# --- Optional: persistence --------------------------------------------------
# MongoDB Atlas free tier, or the bundled compose Mongo.
#   Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#   Compose: mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/?authSource=admin
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# --- Optional: web search ---------------------------------------------------
TAVILY_API_KEY=

# --- Optional: models & behaviour -------------------------------------------
# Required instead of GEMINI_API_KEY while a provider is set to "openai".
OPENAI_API_KEY=
# Model names, used while the matching provider is "openai".
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Ollama settings, used while the matching provider is "ollama". In compose
# the bundled service is reachable at http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MAX_HISTORY_MESSAGES=20
MAX_UPLOAD_BYTES=10485760
MAX_REWRITE_ATTEMPTS=2
MAX_VERIFY_ATTEMPTS=1

# --- Optional: rate limiting ------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Production: security ---------------------------------------------------
# Disable API docs in production — the schema enumerates the attack surface.
ENABLE_API_DOCS=false
# Only answer to your production hostname. "*" disables the check entirely.
ALLOWED_HOSTS=rag.example.com
# Allow your frontend origin to call the API.
CORS_ALLOW_ORIGINS=https://rag.example.com

# --- Production: metrics & proxies -----------------------------------------
# Required once the API is reachable from outside this host: /metrics/prometheus
# serves route names, per-endpoint latency and model spend. The `tls` profile
# blocks the path at the Caddy edge, but a platform that terminates TLS itself
# (Render, a cloud load balancer) has no such edge.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# Comma-separated proxy addresses or CIDR ranges whose X-Forwarded-For is
# believed for rate limiting. Empty trusts nobody. Behind Caddy this is the
# compose network range; on Render, set it to your edge proxy's range or the
# auth rate limit will key on the proxy address instead of the caller.
TRUSTED_PROXIES=

# --- Production: logging ----------------------------------------------------
LOG_LEVEL=WARNING

# --- Production: Grafana ----------------------------------------------------
# Only read when the `observability` profile is started. It is not a required
# variable: compose interpolates the whole file before reading profiles, so a
# hard requirement here would abort the default profile too.
GRAFANA_ADMIN_PASSWORD=   # Set a strong password before enabling observability

# --- Optional: TLS reverse proxy --------------------------------------------
# Read only by the `tls` profile's Caddy service, which is what publishes the
# stack on 443. localhost makes Caddy issue an internal certificate instead of
# calling Let's Encrypt, which is the right default for a trial.
DOMAIN=localhost
# Where Let's Encrypt sends certificate expiry notices. Required for a real
# domain; Caddy fails to parse an argument-less `email` directive.
ACME_EMAIL=admin@localhost

# --- Optional: tracing ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adaptive-rag

# --- Optional: frontend -----------------------------------------------------
API_BASE_URL=http://api:8000

# --- Optional: secrets from files -------------------------------------------
SECRETS_DIR=/run/secrets
