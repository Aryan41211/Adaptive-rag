# Reverse proxy terminating TLS in front of the API and UI.
#
# Caddy obtains and renews certificates from Let's Encrypt automatically, so
# the only configuration needed is a real domain pointing at this host and an
# email address for expiry notices. Both come from the environment:
#
#   DOMAIN=rag.example.com
#   ACME_EMAIL=you@example.com
#
# For a local trial use DOMAIN=localhost, which makes Caddy issue an internal
# certificate instead of contacting Let's Encrypt.

{
	# Compose always supplies a non-empty value: an unset or empty ACME_EMAIL
	# would leave this directive without an argument and fail to parse.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The app is served over TLS only, so HSTS is safe to assert.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API. Caddy sets X-Forwarded-* automatically, which is what lets the
	# application see the real client address its rate limiter keys on.
	handle /auth/* {
		reverse_proxy api:8000
	}

	handle /rag/* {
		# flush_interval -1 disables response buffering, without which
		# Server-Sent Events arrive in one lump at the end and streaming
		# is defeated by the proxy.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /metrics {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	# The interactive schema enumerates every endpoint, parameter and payload
	# shape, which is a map of the attack surface. This profile is the public
	# edge, so it is not served here; reach it on the API port from inside the
	# private network, or delete this block to publish it deliberately.
	handle /docs* {
		respond 404
	}

	handle /redoc* {
		respond 404
	}

	handle /openapi.json {
		respond 404
	}

	# Everything else is the Streamlit UI, which needs websocket upgrades.
	# reverse_proxy passes these through without extra configuration.
	handle {
		reverse_proxy ui:8501
	}
}
