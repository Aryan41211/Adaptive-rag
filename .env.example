# ---------------------------------------------------------------------------
# Adaptive RAG - environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# OpenAI API key. The app refuses to start without it.
OPENAI_API_KEY=sk-your-openai-key-here

# Secret used to sign JWT access tokens. MUST be changed for any deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value

# --- Optional: web search ---------------------------------------------------
# Without this key the "search" route degrades gracefully to a clear message.
TAVILY_API_KEY=

# --- Optional: vector store -------------------------------------------------
# Set QDRANT_URL to store documents in Qdrant. Documents then survive restarts
# and are shared across workers, so the API can run more than one process.
# Leave it empty to use the in-process FAISS index (development only: it is
# lost on restart and confines the API to a single worker).
#   Local:  docker run -p 6333:6333 qdrant/qdrant
#   Cloud:  https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptive_rag_documents

# --- Optional: persistence --------------------------------------------------
# If unset, chat history and users are kept in memory (lost on restart).
# Example: mongodb://localhost:27017
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# --- Optional: models & behaviour -------------------------------------------
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_HISTORY_MESSAGES=20
MAX_UPLOAD_BYTES=10485760
MAX_REWRITE_ATTEMPTS=2
MAX_VERIFY_ATTEMPTS=1
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional: rate limiting ------------------------------------------------
# Bounds model spend per user. Counters are shared through MongoDB when
# configured; without it they are per-process, so the effective limit is
# multiplied by the number of workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Optional: HTTP ---------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty means no
# cross-origin access, which is correct for the Streamlit UI and wrong for a
# browser SPA. Example: https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=
# Comma-separated hostnames the API answers to. "*" disables the check.
ALLOWED_HOSTS=*

# --- Optional: TLS reverse proxy --------------------------------------------
# Used only by the `tls` compose profile:
#   DOMAIN=rag.example.com ACME_EMAIL=you@example.com #     docker compose --profile tls up -d
# Caddy obtains and renews a Let's Encrypt certificate automatically. Use
# DOMAIN=localhost for a local trial, which issues an internal certificate.
DOMAIN=localhost
ACME_EMAIL=

# --- Optional: tracing ------------------------------------------------------
# Set to an OTLP HTTP collector to export traces (Jaeger, Tempo, Honeycomb...).
# Also requires: pip install -r requirements-tracing.txt
# Leave empty to run untraced.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adaptive-rag

# --- Optional: logging ------------------------------------------------------
LOG_LEVEL=INFO

# --- Optional: frontend -----------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
