# ---------------------------------------------------------------------------
# Adaptive RAG - environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Model providers ---------------------------------------------------------
# Pick where chat completions and embeddings run: "openai" (paid, requires
# OPENAI_API_KEY) or "ollama" (local, free). With both set to "ollama" the
# whole stack runs on this machine with no API key and no per-token cost.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- OpenAI (paid) -----------------------------------------------------------
# Only used while LLM_PROVIDER or EMBEDDING_PROVIDER is "openai". Can stay at
# the placeholder below in pure local (Ollama) mode.
OPENAI_API_KEY=sk-your-openai-key-here

# --- Ollama (local, free) ----------------------------------------------------
# Connect to the Ollama server that serves your chosen models. Point it at a
# host-installed server with default URL, or (inside the bundled compose stack)
# at the bundled service via OLLAMA_BASE_URL=http://ollama:11434.
#   Pull a model once:  ollama pull qwen2.5:7b nomic-embed-text
# Any Ollama chat model works; qwen2.5:7b is a good small tool-calling default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Required ----------------------------------------------------------------
# Secret used to sign JWT access tokens. MUST be changed for any deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value

# --- Required by docker compose ----------------------------------------------
# Credentials for the bundled MongoDB. The compose stack refuses to start
# without a password rather than running the database unauthenticated.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
# Keep it alphanumeric: it is embedded in a connection URI, where characters
# such as @ : / ? # would have to be percent-encoded.
#
# Only applied when the `mongo_data` volume is first created. Enabling auth on
# a stack that has already run means: back up, `docker compose down -v`, start
# again, restore.
MONGO_ROOT_USERNAME=adaptive
MONGO_ROOT_PASSWORD=

# --- Optional: web search ---------------------------------------------------
# Without this key the "search" route degrades gracefully to a clear message.
TAVILY_API_KEY=

# --- Optional: vector store -------------------------------------------------
# Set QDRANT_URL to store documents in Qdrant. Documents then survive restarts
# and are shared across workers, so the API can run more than one process.
# Leave it empty to use the in-process FAISS index (development only: it is
# lost on restart and confines the API to a single worker).
#   Local:  docker run -p 6333:6333 qdrant/qdrant
#   Cloud:  https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptive_rag_documents

# --- Optional: persistence --------------------------------------------------
# If unset, chat history and users are kept in memory (lost on restart).
# Example: mongodb://localhost:27017
MONGODB_URL=
MONGODB_DB_NAME=adaptive_rag

# --- Optional: OpenAI models & behaviour ------------------------------------
# Used only while the corresponding provider above is "openai".
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_HISTORY_MESSAGES=20
MAX_UPLOAD_BYTES=10485760
MAX_REWRITE_ATTEMPTS=2
MAX_VERIFY_ATTEMPTS=1
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional: rate limiting ------------------------------------------------
# Bounds model spend per user. Counters are shared through MongoDB when
# configured; without it they are per-process, so the effective limit is
# multiplied by the number of workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Optional: HTTP ---------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Empty means no
# cross-origin access, which is correct for the Streamlit UI and wrong for a
# browser SPA. Example: https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=
# Comma-separated hostnames the API answers to. "*" disables the check.
ALLOWED_HOSTS=*
# Serves /docs, /redoc and /openapi.json. The schema enumerates every endpoint
# and payload shape, so set this to false for anything publicly reachable.
# The `tls` profile's reverse proxy blocks these paths either way.
ENABLE_API_DOCS=true

# --- Optional: secrets from files -------------------------------------------
# Any setting above can instead be supplied as a file named after it in this
# directory - the convention used by Docker secrets, Kubernetes secret volumes
# and most secret managers. This keeps credentials out of the environment,
# where `docker inspect` and every child process can read them back.
# Environment variables win over files when both are present. The directory is
# ignored when it does not exist, so this is safe to leave at its default.
#   e.g.  /run/secrets/openai_api_key  containing just the key
SECRETS_DIR=/run/secrets

# --- Optional: TLS reverse proxy --------------------------------------------
# Used only by the `tls` compose profile:
#   DOMAIN=rag.example.com ACME_EMAIL=you@example.com \
#     docker compose --profile tls up -d
# Caddy obtains and renews a Let's Encrypt certificate automatically. Use
# DOMAIN=localhost for a local trial, which issues an internal certificate.
DOMAIN=localhost
ACME_EMAIL=

# --- Required by docker compose (Grafana) ---------------------------------
# Password for the Grafana admin user. Set to a strong value.
GRAFANA_ADMIN_PASSWORD=

# --- Optional: tracing ------------------------------------------------------
# Set to an OTLP HTTP collector to export traces (Jaeger, Tempo, Honeycomb...).
# Also requires: pip install -r requirements-tracing.txt
# Leave empty to run untraced.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adaptive-rag

# --- Optional: logging ------------------------------------------------------
LOG_LEVEL=INFO

# --- Optional: frontend -----------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
